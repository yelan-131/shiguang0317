{
  "manifest_version": 3,
  "name": "时光剪存",
  "version": "0.2.0",
  "description": "把网页中选中的文字/图片剪存到 GitHub 私有仓库，按日期归档为 Markdown",
  "permissions": ["contextMenus", "storage", "notifications", "tabs"],
  "host_permissions": ["https://api.github.com/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "时光剪存",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
